rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    // Check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Check if the user is accessing their own document
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Check if the user is an admin
    // This requires a document in the 'admins' collection named with the user's UID
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // --- COLLECTION RULES ---

    // 1. Connection Test (used by lib/firebase.ts)
    match /_connection_test_/{docId} {
      allow read: if true;
    }

    // 2. User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();

      // Sub-collections for history and bookmarks
      match /history/{id} {
        allow read, write: if isOwner(userId);
      }
      match /bookmarks/{id} {
        allow read, write: if isOwner(userId);
      }
      // FCM push notification tokens
      match /tokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }
    }

    // 3. Public Content (News, Videos, Wrestlers, Quizzes)
    // Anyone can read, only admins can write
    match /news/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();

      // Likes — only the owner can toggle their own like
      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Dislikes — only the owner can toggle their own dislike
      match /dislikes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // Comments — anyone can read, signed-in users can create,
      // only the comment author can update/delete
      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn();
        allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId;
      }
    }
    
    match /wrestlers/{id} {
      allow read: if true;
      // Admins can write anything; signed-in users can only update the 'followers' array
      allow write: if isAdmin();
      allow update: if isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']);
    }
    
    match /quizzes/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Admin List
    match /admins/{adminId} {
      // Allow specific email to self-promote to admin
      allow create: if request.auth.token.email == 'sportsview60@gmail.com' && request.auth.uid == adminId;
      allow read: if isOwner(adminId);
      allow write: if false; // General writes are still restricted
    }
    
    match /admin/{adminId} {
      allow create: if request.auth.token.email == 'sportsview60@gmail.com' && request.auth.uid == adminId;
      allow read: if isOwner(adminId);
      allow write: if false;
    }

    // 5. Restored ROSTER
    match /ROSTER/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']);
    }
    
    match /roster/{id} {
      allow read: if true;
      allow write: if isAdmin();
      allow update: if isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers']);
    }

    // 6. YouTube Videos
    match /youtube_videos/{id} {
      allow read: if true;
      allow write: if isAdmin() || request.resource.data.syncToken == "ringzone-cron-secret-2026";
    }

    // 7. Sports Hub (Settings, Banners, Analytics, Notifications)
    // Anyone can read, only admins can write
    match /sportsSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /sportsBanners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /sportsAnalytics/{id} {
      allow read: if true;
      allow write: if isAdmin();
      // Allow any user to increment views or clicks counters securely
      allow update: if true && 
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['views', 'clicks', 'favoritesCount']);
    }
    
    match /pushNotifications/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Legal Documents (Privacy, Terms, Cookies, Data Deletions)
    match /legal/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Default Deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

